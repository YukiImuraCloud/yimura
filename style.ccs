body {
    font-family: sans-serif;
    text-align: center;
    margin-top: 50px;
}
#news {
    max-width: 1000px;
    margin: 0 auto;
    text-align: left;
}

#news ul {
    line-height: 1.8;
}

#news li {
    margin-bottom: 12px;
}
nav {
background: rgba(0,0,0,0.25);
backdrop-filter: blur(10px);
position: sticky;
top: 0;
z-index: 100;
}

.menu {
list-style: none;
margin: 0;
padding: 0;
display: flex;
justify-content: center;
}

.menu a {
display: block;
padding: 18px 35px;
color: white;
text-decoration: none;
font-weight: bold;
}

.menu a:hover {
background: rgba(255,255,255,0.2);
}

.me{
    font-weight:bold;
    text-decoration:underline;
}

.profile-container{
    max-width:1000px;
    margin:0 auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 40px;
}

.profile-text{
    text-align:left;
}

.profile-text h1{
    margin:0;
    font-size:3em;
}

.profile-text p{
    margin-top:10px;
    font-size:1.2em;
    line-height:1.6;
}

.profile-photo{
    width:140px;
    height:140px;
    object-fit:cover;
    border-radius:50%;
    border:4px solid white;
    box-shadow:0 3px 12px rgba(0,0,0,0.25);
}
