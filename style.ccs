body{

    margin:0;

    font-family:Arial,sans-serif;

    background:linear-gradient(135deg,#0f4c81,#00a8e8,#90e0ef);

    color:#333;

}



nav{

    background:rgba(0,0,0,0.25);

    backdrop-filter:blur(10px);

    position:sticky;

    top:0;

}



.menu{

    list-style:none;

    margin:0;

    padding:0;

    display:flex;

    justify-content:center;

}



.menu a{

    display:block;

    padding:18px 35px;

    color:white;

    text-decoration:none;

    font-weight:bold;

}



.menu a:hover{

    background:rgba(255,255,255,0.2);

}



.container{

    max-width:1100px;

    margin:40px auto;

    background:rgba(255,255,255,0.95);

    padding:40px;

    border-radius:15px;

    box-shadow:0 5px 20px rgba(0,0,0,0.2);

}



h1{

    color:#0077b6;

}



h2{

    border-left:8px solid #0077b6;

    padding-left:15px;

    color:#0077b6;

    margin-top:40px;

}



.timeline{

    list-style:none;

    padding:0;

}



.timeline li{

    margin-bottom:18px;

    line-height:1.8;

}



.period{

    font-weight:bold;

    color:#0077b6;

}



.lab-box{

    background:#f4f9fc;

    border-left:6px solid #0077b6;

    padding:15px;

    margin-bottom:20px;

    border-radius:8px;

}



a{

    color:#0077b6;

}



a:hover{

    text-decoration:underline;

}

.me {
    font-weight: bold;
    text-decoration: underline;
}
