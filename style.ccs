body {
    font-family: sans-serif;
    text-align: center;
    margin-top: 50px;
}
#news {
    max-width: 1000px;
    margin: 0 auto;
    text-align: left;
}

#news ul {
    line-height: 1.8;
}

#news li {
    margin-bottom: 12px;
}
nav {
background: rgba(0,0,0,0.25);
backdrop-filter: blur(10px);
position: sticky;
top: 0;
z-index: 100;
}

.menu {
list-style: none;
margin: 0;
padding: 0;
display: flex;
justify-content: center;
}

.menu a {
display: block;
padding: 18px 35px;
color: white;
text-decoration: none;
font-weight: bold;
}

.menu a:hover {
background: rgba(255,255,255,0.2);
}
