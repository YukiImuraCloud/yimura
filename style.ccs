body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #0f4c81, #00a8e8, #90e0ef);
    color: #333;
}

header {
    text-align: center;
    padding: 60px 20px;
    color: white;
}

header h1 {
    font-size: 3em;
    margin-bottom: 10px;
}

header p {
    font-size: 1.2em;
}

#news {
    max-width: 1000px;
    margin: 40px auto;
    background: rgba(255,255,255,0.95);
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.2);
}

#news h2 {
    border-left: 8px solid #0077b6;
    padding-left: 15px;
    color: #0077b6;
}

#news ul {
    line-height: 1.8;
}

#news li {
    margin-bottom: 12px;
}

a {
    color: #0077b6;
    text-decoration: none;
}

a:hover {
    text-decoration: underline;
}
